# Local development only. Copy this file to .dev.vars and keep .dev.vars out of Git.
# Paste ONLY the Météo-France API Key token. The Worker sends it as `Authorization: Bearer <API_KEY>` to DPVigilance.
METEOFRANCE_API_KEY=PASTE_METEOFRANCE_API_KEY_HERE
ADMIN_PASSWORD="change-me"
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"
ANALYTICS_HASH_SECRET="replace-with-another-long-random-secret"
