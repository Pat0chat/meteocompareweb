{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meteocompare",
  "main": "./worker.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/_mcx/*",
      "/admin",
      "/admin/*",
      "/admin.html",
      "/admin.js",
      "/admin.css"
    ],
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ANALYTICS",
        "class_name": "AnalyticsStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "analytics-v1",
      "new_sqlite_classes": [
        "AnalyticsStore"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  }
}
