{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "meteocompare",
  "main": "./worker.js",
  "compatibility_date": "2026-08-19",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/_mcx/*"],
    "not_found_handling": "single-page-application"
  }
}
